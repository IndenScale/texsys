# macOS
.DS_Store

# 本地参考资料：原始图纸与客户文档不入库，来源与校验和见 docs/references.md
refs/

# 代理/编辑器临时附件
.kimi-attachments/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# 构建与本地环境
build/
!spec/build/
dist/

# 示例只保留空 build 目录，生成物仍全部忽略
!examples/**/build/
examples/**/build/*
!examples/**/build/.gitkeep
node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.uv/

# 原始资料常见格式（即使误放也不入库）
*.rar
*.zip
*.dwg
