#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "ChannelBase"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.045, 0.007)
            double3 xformOp:translate = (0.3, 0.0225, 0.0035)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ChannelFront"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.006, 0.035)
            double3 xformOp:translate = (0.3, 0.003, 0.0245)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ChannelBack"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.006, 0.035)
            double3 xformOp:translate = (0.3, 0.042, 0.0245)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "LeftRod" (
            prepend references = @../../threaded-rod/assets/geometry.usda@</Module/Geometry>
        )
        {
            double3 xformOp:translate = (0.028, 0.0105, 0.042)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "RightRod" (
            prepend references = @../../threaded-rod/assets/geometry.usda@</Module/Geometry>
        )
        {
            double3 xformOp:translate = (0.548, 0.0105, 0.042)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "Ports"
    {
        def Xform "anchor_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.04, 0.0225, 0.492)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "anchor_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.56, 0.0225, 0.492)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tray_bearing"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.3, 0.0225, 0.042)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

