#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cylinder "Jacket"
        {
            uniform token axis = "Y"
            double height = 0.96
            color3f[] primvars:displayColor = [(0.1, 0.4, 0.68)]
            double radius = 0.0035
            double3 xformOp:translate = (0.01, 0.5, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "PlugA"
        {
            color3f[] primvars:displayColor = [(0.11, 0.15, 0.19)]
            double size = 1
            float3 xformOp:scale = (0.02, 0.02, 0.016)
            double3 xformOp:translate = (0.01, 0.01, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "PlugB"
        {
            color3f[] primvars:displayColor = [(0.11, 0.15, 0.19)]
            double size = 1
            float3 xformOp:scale = (0.02, 0.02, 0.016)
            double3 xformOp:translate = (0.01, 0.99, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "end_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.01, 0, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "end_b"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.01, 1, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

