#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "SteelPan"
        {
            color3f[] primvars:displayColor = [(0.58, 0.64, 0.68)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.6, 0.032)
            double3 xformOp:translate = (0.3, 0.3, 0.016)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "HPL"
        {
            color3f[] primvars:displayColor = [(0.78, 0.81, 0.82)]
            double size = 1
            float3 xformOp:scale = (0.6, 0.6, 0.003)
            double3 xformOp:translate = (0.3, 0.3, 0.0335)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "support"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.3, 0.3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

