            double size = 1
            float3 xformOp:scale = (0.016, 0.004, 0.012)
            double3 xformOp:translate = (0.17, 0.002, 0.04445)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

