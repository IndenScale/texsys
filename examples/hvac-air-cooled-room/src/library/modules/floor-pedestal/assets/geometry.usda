#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Base"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.1, 0.1, 0.008)
            double3 xformOp:translate = (0.05, 0.05, 0.004)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Head"
        {
            color3f[] primvars:displayColor = [(0.58, 0.64, 0.68)]
            double size = 1
            float3 xformOp:scale = (0.092, 0.092, 0.025)
            double3 xformOp:translate = (0.05, 0.05, 0.4025)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "Stem"
        {
            uniform token axis = "Z"
            double height = 0.382
            color3f[] primvars:displayColor = [(0.58, 0.64, 0.68)]
            double radius = 0.015
            double3 xformOp:translate = (0.05, 0.05, 0.199)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "Ports"
    {
        def Xform "head"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.05, 0.05, 0.415)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "base"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.05, 0.05, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

