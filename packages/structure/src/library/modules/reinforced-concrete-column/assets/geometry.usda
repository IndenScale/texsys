            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.175, 0.175, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "top"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.175, 0.175, 2.7)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

