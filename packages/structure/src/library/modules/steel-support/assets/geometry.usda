#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "BottomFlange"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.15, 1.2, 0.012)
            double3 xformOp:translate = (0.075, 0.6, 0.006)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Web"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.008, 1.2, 0.276)
            double3 xformOp:translate = (0.075, 0.6, 0.15000000000000002)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TopFlange"
        {
            color3f[] primvars:displayColor = [(0.3, 0.39, 0.48)]
            double size = 1
            float3 xformOp:scale = (0.15, 1.2, 0.012)
            double3 xformOp:translate = (0.075, 0.6, 0.294)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "bearing_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.075, 0, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "bearing_b"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.075, 1.2, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "suspension"
        {
            custom double3 texsys:normal = (0, 0, -1)
            double3 xformOp:translate = (0.075, 0.6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

