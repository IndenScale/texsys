#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cylinder "Bar_001"
        {
            uniform token axis = "Y"
            double height = 1.2
            color3f[] primvars:displayColor = [(0.28, 0.39, 0.48)]
            double radius = 0.008
            double3 xformOp:translate = (0.008, 0.6, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

