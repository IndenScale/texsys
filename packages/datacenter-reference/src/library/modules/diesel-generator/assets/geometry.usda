#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.3, 0.45, 0.35)]
            double size = 1
            double3 xformOp:scale = (6.0, 2.4, 2.6)
            double3 xformOp:translate = (3.0, 1.2, 1.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "ac_out"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (5.8, 1.2, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "fuel_in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.2, 1.2, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "exhaust"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (3.0, 1.2, 2.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "control"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.2, 0.3, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
