#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.2)]
            double size = 1
            double3 xformOp:scale = (0.1, 0.1, 1.6)
            double3 xformOp:translate = (0.05, 0.05, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "in"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.05, 0.05, 1.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_1"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 0.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_2"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_3"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 0.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_4"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_5"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_6"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_7"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 1.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_8"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.05, 0.0, 1.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
