#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.49, 0.51, 0.55)]
            double size = 1
            double3 xformOp:scale = (0.72, 1.0, 2.1)
            double3 xformOp:translate = (0.36, 0.5, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "in_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.14, 0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "in_b"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.58, 0, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out_4"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.36, 1.0, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
