#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.25, 0.35, 0.3)]
            double size = 1
            double3 xformOp:scale = (0.8, 0.8, 2.0)
            double3 xformOp:translate = (0.4, 0.4, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "dc"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.4, 0.4, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
