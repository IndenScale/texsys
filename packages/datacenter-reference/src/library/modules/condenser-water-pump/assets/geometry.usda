#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.35, 0.4, 0.45)]
            double size = 1
            double3 xformOp:scale = (1.2, 0.5, 0.8)
            double3 xformOp:translate = (0.6, 0.25, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0.1, 0.25, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (1.1, 0.25, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "power"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.6, 0.25, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
