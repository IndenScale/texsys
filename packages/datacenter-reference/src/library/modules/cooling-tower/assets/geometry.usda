#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.4, 0.5, 0.45)]
            double size = 1
            double3 xformOp:scale = (3.0, 3.0, 3.5)
            double3 xformOp:translate = (1.5, 1.5, 1.75)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "cw_in"
        {
            custom double3 texsys:normal = (-1, 0, 0)
            double3 xformOp:translate = (0, 1.5, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "cw_out"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (3, 1.5, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "makeup"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (1.5, 3, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "blowdown"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (2.2, 3, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "fan_power"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (1.5, 2.8, 3.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
