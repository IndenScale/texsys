#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.35, 0.4, 0.45)]
            double size = 1
            double3 xformOp:scale = (1.8, 1.2, 2.0)
            double3 xformOp:translate = (0.9, 0.6, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "primary"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.4, 0.6, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "secondary"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (1.4, 0.6, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
