#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.5, 0.45, 0.4)]
            double size = 1
            double3 xformOp:scale = (0.8, 0.6, 2.0)
            double3 xformOp:translate = (0.4, 0.3, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "source_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.2, 0.1, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "source_b"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.6, 0.1, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "out"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.4, 0.5, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
