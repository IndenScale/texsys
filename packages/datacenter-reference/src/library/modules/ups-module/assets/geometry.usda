#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.2, 0.3, 0.5)]
            double size = 1
            double3 xformOp:scale = (0.6, 0.8, 2.0)
            double3 xformOp:translate = (0.3, 0.4, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "ac_in"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.15, 0.1, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "ac_out"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.45, 0.1, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "battery"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.3, 0.7, 2.0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
