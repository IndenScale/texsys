#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Envelope"
        {
            color3f[] primvars:displayColor = [(0.3, 0.38, 0.45)]
            double size = 1
            double3 xformOp:scale = (7.4, 3.68, 2.9)
            double3 xformOp:translate = (3.7, 1.84, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "power_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.640, 0, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "power_b"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.980, 0, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "fws_supply"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (2.810, 0, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "fws_return"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (4.740, 0, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "alarm"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (6.850, 0, 1.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
