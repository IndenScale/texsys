#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Cabinet"
        {
            color3f[] primvars:displayColor = [(0.57, 0.68, 0.72)]
            double size = 1
            double3 xformOp:scale = (0.6, 0.8, 1.5)
            double3 xformOp:translate = (0.3, 0.4, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Panel"
        {
            color3f[] primvars:displayColor = [(0.22, 0.36, 0.44)]
            double size = 1
            double3 xformOp:scale = (0.52, 0.03, 1.2)
            double3 xformOp:translate = (0.3, 0.015, 0.71)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Control"
        {
            color3f[] primvars:displayColor = [(0.16, 0.65, 0.64)]
            double size = 1
            double3 xformOp:scale = (0.26, 0.018, 0.16)
            double3 xformOp:translate = (0.25, 0.009, 1.12)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "ServiceBand"
        {
            color3f[] primvars:displayColor = [(0.33, 0.53, 0.58)]
            double size = 1
            double3 xformOp:scale = (0.46, 0.025, 0.34)
            double3 xformOp:translate = (0.30000000000000004, 0.0125, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "facility_in"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.12, 0.4, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "facility_out"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.48, 0.4, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (0.6, 0.4, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_return"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.12, 0, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_supply"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.48, 0, 0.75)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

