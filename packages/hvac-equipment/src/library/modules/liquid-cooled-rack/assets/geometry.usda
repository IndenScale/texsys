#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Cabinet"
        {
            color3f[] primvars:displayColor = [(0.24, 0.31, 0.38)]
            double size = 1
            double3 xformOp:scale = (0.8, 1.2, 2.2)
            double3 xformOp:translate = (0.4, 0.6, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Door"
        {
            color3f[] primvars:displayColor = [(0.11, 0.16, 0.22)]
            double size = 1
            double3 xformOp:scale = (0.7, 0.035, 2.04)
            double3 xformOp:translate = (0.39999999999999997, 0.0175, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Indicator"
        {
            color3f[] primvars:displayColor = [(0.19, 0.76, 0.79)]
            double size = 1
            double3 xformOp:scale = (0.08, 0.02, 0.09)
            double3 xformOp:translate = (0.64, 0.01, 1.905)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "tcs_in_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.15, 0.16, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_out_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.31, 0.42, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_in_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.48, 0.68, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "tcs_out_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.64, 0.94, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_a"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.13, 1.08, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "power_b"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.69, 1.08, 2.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_in_a"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.2, 0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_in_b"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.6, 0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_out_a"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.2, 1.2, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "air_out_b"
        {
            custom double3 texsys:normal = (0, 1, 0)
            double3 xformOp:translate = (0.6, 1.2, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

