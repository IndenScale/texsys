#usda 1.0
(
    defaultPrim = "Module"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Module"
{
    def Scope "Geometry"
    {
        def Cube "Cabinet"
        {
            color3f[] primvars:displayColor = [(0.69, 0.76, 0.81)]
            double size = 1
            double3 xformOp:scale = (0.76, 0.8, 2.1)
            double3 xformOp:translate = (0.38, 0.4, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Panel"
        {
            color3f[] primvars:displayColor = [(0.24, 0.33, 0.4)]
            double size = 1
            double3 xformOp:scale = (0.68, 0.035, 1.72)
            double3 xformOp:translate = (0.38, 0.0175, 1.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Grille"
        {
            color3f[] primvars:displayColor = [(0.36, 0.53, 0.6)]
            double size = 1
            double3 xformOp:scale = (0.66, 0.022, 1.5)
            double3 xformOp:translate = (0.38, 0.011, 1.12)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Control"
        {
            color3f[] primvars:displayColor = [(0.17, 0.66, 0.65)]
            double size = 1
            double3 xformOp:scale = (0.16, 0.017, 0.13)
            double3 xformOp:translate = (0.19, 0.0085, 1.9549999999999998)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "Ports"
    {
        def Xform "power"
        {
            custom double3 texsys:normal = (1, 0, 0)
            double3 xformOp:translate = (0.76, 0.24, 0.28)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "return"
        {
            custom double3 texsys:normal = (0, -1, 0)
            double3 xformOp:translate = (0.38, 0, 1.12)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "supply"
        {
            custom double3 texsys:normal = (0, 0, 1)
            double3 xformOp:translate = (0.38, 0.4, 2.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

